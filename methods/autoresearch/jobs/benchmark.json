{
  "_comment": "Benchmark composition for the autoresearch loop on topology_heuristic_job. Paths are relative to the repo root.  The MILP reference values for these instances live in baseline_metrics.json, populated by precompute_baseline.py.",

  "weight_profile": {
    "weight_makespan":  0.1,
    "weight_delay":     1.0,
    "weight_movements": 10.0,
    "weight_topology":  1.0,
    "alpha":            0.3,
    "n_starts":         6,
    "seed":             1
  },

  "fast_eval": {
    "_description": "Four small/medium instances spanning R=5, R=10, and R=20. ~1.5 minutes total. Used at every iteration.  The R=20 instance was added in iter_0010 to make the metric sensitive to LNS-side improvements that don't move R<=10 results.",
    "time_limit_per_run": 20,
    "instances": [
      "problems/jobs/instances/scn_triangle_tight_P5_R5/scn_triangle_tight_P5_R5_seed1.json",
      "problems/jobs/instances/scn_chain_tight_P5_R10/scn_chain_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_hub_tight_P5_R10/scn_hub_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_triangle_tight_P5_R20/scn_triangle_tight_P5_R20_seed1.json"
    ]
  },

  "validation": {
    "_description": "Twelve seed-1 configurations from instances_202605_02. ~12 minutes total. Only invoked on demand to certify a candidate-best.",
    "time_limit_per_run": 60,
    "instances": [
      "problems/jobs/instances/scn_chain_tight_P5_R10/scn_chain_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_full_tight_P5_R10/scn_full_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_full_tight_P5_R20/scn_full_tight_P5_R20_seed1.json",
      "problems/jobs/instances/scn_hub_tight_P5_R10/scn_hub_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_none_tight_P5_R10/scn_none_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_triangle_loose_P5_R10/scn_triangle_loose_P5_R10_seed1.json",
      "problems/jobs/instances/scn_triangle_medium_P5_R10/scn_triangle_medium_P5_R10_seed1.json",
      "problems/jobs/instances/scn_triangle_tight_P5_R10/scn_triangle_tight_P5_R10_seed1.json",
      "problems/jobs/instances/scn_triangle_tight_P5_R20/scn_triangle_tight_P5_R20_seed1.json",
      "problems/jobs/instances/scn_triangle_tight_P5_R30/scn_triangle_tight_P5_R30_seed1.json",
      "problems/jobs/instances/scn_triangle_tight_P5_R5/scn_triangle_tight_P5_R5_seed1.json",
      "problems/jobs/instances/scn_two_rows_tight_P5_R10/scn_two_rows_tight_P5_R10_seed1.json"
