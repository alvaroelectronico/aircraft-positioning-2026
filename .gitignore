# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# OS noise
.DS_Store
Thumbs.db

# Editor / IDE
*.swp
*~

# Claude Code harness state — ignore everything inside .claude/ EXCEPT
# project-level tooling (agents and skills) that the whole team shares.
.claude/*
!.claude/agents/
!.claude/skills/

# LaTeX build artifacts (paper sources are versioned; transient artefacts are not)
papers/**/*.aux
papers/**/*.bbl
papers/**/*.blg
papers/**/*.fdb_latexmk
papers/**/*.fls
papers/**/*.out
papers/**/*.synctex.gz
papers/**/*.toc
papers/**/*.log
papers/**/*.pdf
