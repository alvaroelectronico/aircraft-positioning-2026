# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# OS noise
.DS_Store
Thumbs.db

# Editor / IDE
*.swp
*~

# Claude Code harness state — ignore everything inside .claude/ EXCEPT
# project-level tooling (agents and skills) that the whole team shares.
.claude/*
!.claude/agents/
!.claude/skills/

# LaTeX build artifacts (paper sources are versioned; transient artefacts are not)
papers/**/*.aux
papers/**/*.bbl
papers/**/*.blg
papers/**/*.fdb_latexmk
papers/**/*.fls
papers/**/*.out
papers/**/*.synctex.gz
papers/**/*.toc
papers/**/*.log
papers/**/*.pdf

# per-run scratch output.  Two things stay tracked on purpose:
#   - outputs/solutions/results.csv  (the ledger; the cached-MILP rule in
#     experiments/BATTERY.md reads its rows)
#   - the cached MILP solution JSONs  (fixed reference data, never re-run)
# Everything else under outputs/solutions/ is a per-run artefact: one JSON per
# (instance, label, timestamp), ~10 kB each, thousands per battery.  This
# replaces the per-method deny-list that had to grow with every new method.
data/logs_heuristic/
outputs/logs_heuristic/
outputs/solutions/*.json
!outputs/solutions/*__milp_*.json
